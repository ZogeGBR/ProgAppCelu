# Copiar a .env y completar. NUNCA subir .env al repositorio.
PORT=3000

# Mercado Pago: Tu integración > Credenciales (usar las de prueba para desarrollar).
# Sin token, los pagos funcionan en modo simulado.
MP_ACCESS_TOKEN=
MP_SANDBOX=false
# Clave secreta de webhooks (Tu integración > Webhooks) para validar x-signature.
MP_WEBHOOK_SECRET=

# Google AI Studio (Gemini). Sin clave, la IA devuelve una etiqueta de ejemplo.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# URL pública https del backend (por ej. con un túnel o un hosting).
# Hace falta para que Mercado Pago avise los pagos (webhook) y para volver a la app.
URL_PUBLICA=

# Cuentas del almacén. Se crean la PRIMERA vez que arranca el servidor
# (contraseña de 8 caracteres o más). Después se cambian desde la app con
# "¿Olvidaste tu contraseña?".
DUENO_EMAIL=
DUENO_CLAVE=
REPARTIDOR_EMAIL=
REPARTIDOR_CLAVE=

# Correo para mandar el código de recuperación (por ej.
# smtps://usuario:clave@smtp.gmail.com:465). Sin valor, el código se
# muestra en la consola del servidor.
SMTP_URL=
CORREO_REMITENTE=FreshMarket <no-responder@freshmarket.com.ar>

# Mapa: de un punto a "calle y número". Sin clave de Google se usa
# Nominatim (OpenStreetMap), gratis. CONTACTO_MAPAS es un email o web que
# Nominatim pide para identificar la app. GEOCODIFICACION=simulado para
# trabajar sin internet.
GOOGLE_MAPS_API_KEY=
CONTACTO_MAPAS=
GEOCODIFICACION=nominatim
# Firma las sesiones. Sin valor se genera uno al arrancar (y hay que volver a
# ingresar cada vez que se reinicia el servidor).
SECRETO_SESION=

# Simular al repartidor mientras no mande su GPS (true/false). Sin valor, se
# simula solo si Mercado Pago también está simulado.
SIMULAR_REPARTO=

# Archivo de la base de datos (SQLite).
RUTA_BD=freshmarket.db
